# ===== LLM (vendor + model 分离) =====
# Layer 1: 选厂商 (zhipu | minimax | openai)
#   缺省: zhipu
LLM_VENDOR=zhipu

# Layer 2: (可选) 选具体模型,缺省用 vendor 的 default_model
#   zhipu default:  glm-5.1
#   minimax default: MiniMax-M2.7
#   openai default: o3-mini
# LLM_MODEL=MiniMax-M3

# Per-vendor API key env var:
#   zhipu / minimax  →  LLM_API_KEY
#   openai            →  OPENAI_API_KEY
LLM_API_KEY=
# OPENAI_API_KEY=

# Override(应急逃生口,99% 不用)
# LLM_MODEL_OVERRIDE=
# LLM_BASE_URL_OVERRIDE=
# LLM_API_KEY_OVERRIDE=
LLM_TEMPERATURE=0.7

# ===== 数据目录 =====
DATA_DIR=./data
SEED_DIR=./seed
CHROMA_DIR=./data/chroma
SQLITE_PATH=./data/yanzhao.db

# ===== 爬虫 =====
YANZHAO_BASE_URL=https://yz.chsi.com.cn
SCRAPER_MIN_DELAY=1.5
SCRAPER_MAX_DELAY=3.0
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# ===== Embedding =====
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./models

# ===== Chainlit =====
CHAINLIT_HOST=127.0.0.1
CHAINLIT_PORT=8000
